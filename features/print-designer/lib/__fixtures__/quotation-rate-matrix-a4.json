{
  "schemaVersion": 1,
  "layoutMode": "GRAPHIC",
  "meta": {
    "gallery": "quotation-rate-matrix-a4",
    "description": "A4 quotation rate analysis — letterhead, party block, item grid, and a CROSSTAB that cross-tabulates taxable value by HSN against GST rate slab with row and column totals.",
    "datasets": {
      "header": "MASTER. The same header query the QUOTATION_A4 design uses — company/branch letterhead, quotation identity, party block and the money totals.",
      "items": "DETAIL. The same items query the QUOTATION_A4 design uses. The crosstab pivots THIS dataset; no extra query is needed.",
      "note": "Paper and datasets come from the version and its print_template_dataset rows, not from this body. Install against a revision that already declares header (MASTER) and items (DETAIL)."
    },
    "crosstab": "ct-hsn-rate cross-tabulates items by hsn_code (rows) against tax_perc (columns), summing taxable_amt. It replaces the GROUP_HEADER + DETAIL pair a rate summary would otherwise need."
  },
  "paper": {
    "code": "A4",
